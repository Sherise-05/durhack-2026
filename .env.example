# Local web server. Real credentials belong only in your ignored .env.
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Optional. If blank, a random persistent secret is stored in instance/.
SESSION_SECRET=
SESSION_HTTPS_ONLY=False

# Server-side conversational profile setup. Never expose this key in the browser.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Google Calendar connection; use the exact redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Reserved for a future Tiger Data adapter. The local app currently uses SQLite.
DATABASE_URL=postgresql://USER@HOST:PORT/DATABASE?sslmode=require
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Demo shortcut: Sleep now and Nap now ring after this many seconds. 0 = real timers.
DEMO_TIMER_SECONDS=10

# Spoken wake-up messages (ElevenLabs text to speech). Real key only in your ignored .env.
ELEVENLABS_API_KEY=
